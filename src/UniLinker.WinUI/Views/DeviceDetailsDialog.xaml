<ContentDialog
    x:Class="UniLinker.WinUI.Views.DeviceDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{Binding Name}"
    PrimaryButtonText="Close"
    DefaultButton="Primary"
    Loaded="OnLoaded"
    Closing="OnClosing">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Device Info Card -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Padding="16">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Icon -->
                <Border Grid.Column="0"
                        Width="48" Height="48"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="24">
                    <FontIcon Glyph="{Binding State, Converter={StaticResource PeerStateIconConverter}}"
                              FontSize="22"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <!-- Device Details -->
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               FontSize="16"/>
                    <TextBlock FontFamily="Consolas">
                        <Run Text="IP: "/>
                        <Run Text="{Binding IpAddress}"/>
                        <Run Text=" : "/>
                        <Run Text="{Binding Port}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Version}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"/>
                </StackPanel>

                <!-- Capabilities -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <!-- Screen capture icon -->
                    <Border Width="32" Height="32"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Visibility="{Binding Capabilities, Converter={StaticResource CapabilityVisibilityConverter}, ConverterParameter='screen-capture'}">
                        <FontIcon Glyph="&#xE960;" FontSize="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <!-- File transfer icon -->
                    <Border Width="32" Height="32"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Visibility="{Binding Capabilities, Converter={StaticResource CapabilityVisibilityConverter}, ConverterParameter='file-transfer'}">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 Area -->
        <Grid Grid.Row="1">
            <WebView2 x:Name="WebView"
                       Source="about:blank"/>

            <!-- Loading indicator -->
            <ProgressRing x:Name="LoadingIndicator"
                          Width="48" Height="48"
                          IsActive="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</ContentDialog>
