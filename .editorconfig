# EditorConfig — 基础一致性；不强制 end_of_line（避免全仓 reformat）
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.kt]
indent_style = space
indent_size = 4

[*.{js,html,css,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
